# 复制成 config.env，改掉每个示例值；config.env 不要提交到 Git，也不要发微信群。
# 云平台（ClawCloud / Railway）不用这个文件，直接在控制台逐条添加同名环境变量即可。

# Caddy 用的域名：只写域名，不带 https://，不带结尾斜杠。没有域名就先随便填，改用 http 访问。
RUNCLUB_DOMAIN=run.example.com
# 站点的完整地址，末尾不带斜杠；填了以后只接受来自这个地址的写操作。
PUBLIC_ORIGIN=https://run.example.com
# 群友输入的口令，发到微信群的也是这个。
GROUP_CODE=REPLACE_WITH_A_NEW_GROUP_CODE
# 只用于创建第一位管理员，绝对不要发群。
ADMIN_SETUP_CODE=REPLACE_WITH_A_LONG_RANDOM_SETUP_CODE
